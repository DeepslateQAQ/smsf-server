# =============================================================================
# smsf-server 环境变量示例
#
# 复制为 .env 后按需修改：
#   - Docker Compose / 容器：把本文件复制到仓库根的 .env（或 docker compose 同目录）
#   - 源码 uv 运行：从 backend/ 目录启动时，pydantic-settings 会读取 backend/.env
#     （即 `cp .env.example backend/.env`）
#
# 变量全部带前缀 SMSF_，与 backend/app/config.py 的 Settings 一一对应。
# 值为空表示使用代码里的默认值；注释中的「默认」即代码默认值。
# =============================================================================

# ------------------------------------------------------------------ 数据库
# SQLAlchemy 连接串。sqlite 需要 4 个斜杠表示绝对路径。
# 留空时由 SMSF_DATA_DIR 推导（见下）；两者都留空则落在「当前工作目录」下的 data/。
# 注意：默认值**不会**跟着代码目录走——Nix 打包后代码在只读的 /nix/store，
# 在那里建目录会直接崩。
# Docker Compose 覆盖为：sqlite+pysqlite:////app/data/smsf.sqlite3
SMSF_DATABASE_URL=

# 数据目录（数据库文件所在目录）。Nix wrapper 会把它默认设成
# $HOME/.local/share/smsf-server；systemd 部署也建议显式指定一个可写绝对路径。
# 仅当 SMSF_DATABASE_URL 留空时生效。
SMSF_DATA_DIR=

# ------------------------------------------------------------------ 会话
# 登录会话有效期（天）。默认 30
SMSF_SESSION_TTL_DAYS=30
# 会话 Cookie 名称。默认 smsf_session
SMSF_SESSION_COOKIE_NAME=smsf_session
# 【重点】Cookie 是否加 Secure 标记。
#   默认 false（本机 HTTP 调试）。只要通过 HTTPS 反向代理对外提供服务，
#   必须置 true，否则浏览器不会在 HTTPS 之外的场景回传 Cookie。
SMSF_COOKIE_SECURE=false

# ------------------------------------------------------------------ 部署
# 监听地址。默认 0.0.0.0
SMSF_HOST=0.0.0.0
# 监听端口。默认 8801
SMSF_PORT=8801
# 启动时自动执行 alembic upgrade head。默认 true
SMSF_AUTO_MIGRATE=true
# 【重点】反向代理暴露的前缀路径（ASGI root_path）。
#   例如通过 https://example.com/smsf/ 访问，则填 /smsf；
#   根路径直接访问保持留空。默认留空
SMSF_ROOT_PATH=
# 客户端 IP 来源模式：off / x-forwarded-for / cf-connecting-ip。默认 off
# x-forwarded-for 仅适用于可信的单层代理，服务端取追加链的最右 IP。
# cf-connecting-ip 仅适用于 TCP 对端就是 Cloudflare 边缘 IP 的入口；直连暴露时可被伪造，严禁开启。
SMSF_CLIENT_IP_SOURCE=off
# 应用日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL。默认 INFO
SMSF_LOG_LEVEL=INFO
# 前端静态文件目录。默认 <backend>/app/static（容器内由 Dockerfile 拷入）
# SMSF_STATIC_DIR=

# ------------------------------------------------------------------ 入库防护
# 单次请求体大小上限（字节）。默认 32768
SMSF_MAX_BODY_BYTES=32768
# 单条消息正文长度上限（字符）。默认 8192
SMSF_MAX_CONTENT_CHARS=8192
# 每设备每分钟入库限速。默认 60
SMSF_RATE_LIMIT_PER_DEVICE_PER_MIN=60

# ------------------------------------------------------------------ 登录防护
# 触发锁定前允许的连续失败次数。默认 5
SMSF_LOGIN_MAX_FAILURES=5
# 登录失败锁定时长（分钟）。默认 15
SMSF_LOGIN_LOCK_MINUTES=15
# 来源 IP 连续失败次数上限。默认 20；用于防止跨用户名喷洒和锁定 DoS
SMSF_LOGIN_IP_MAX_FAILURES=20
# 来源 IP 限速窗口（分钟）。默认 15
SMSF_LOGIN_IP_LOCK_MINUTES=15
# 签名时间戳允许的最大偏差（小时），防止重放。默认 24
SMSF_SIGN_MAX_SKEW_HOURS=24

# ------------------------------------------------------------------ 前端
# 开发模式下允许的跨域来源（逗号分隔）。默认 http://localhost:5173,http://127.0.0.1:5173
SMSF_DEV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
